      "reference_sql": "SELECT COUNT(*) AS customers_without_orders\n            FROM customers AS c\n            WHERE NOT EXISTS (\n                SELECT 1\n                FROM orders AS o\n                WHERE o.customer_id = c.customer_id\n            )",
