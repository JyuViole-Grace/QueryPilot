    {
      "id": "q09",
      "question": "Which categories have the highest gross value of products sold in delivered orders before discounts? Show all categories.",
      "category": "multi_table_aggregation",
      "reference_sql": "SELECT\n                c.name AS category_name,\n                SUM(oi.quantity * oi.unit_price_cents) AS gross_sales_cents\n            FROM categories AS c\n            JOIN products AS p ON p.category_id = c.category_id\n            JOIN order_items AS oi ON oi.product_id = p.product_id\n            JOIN orders AS o ON o.order_id = oi.order_id\n            WHERE o.status = 'delivered'\n            GROUP BY c.category_id, c.name\n            ORDER BY gross_sales_cents DESC, c.name",
      "expected_columns": [
        "category_name",
        "gross_sales_cents"
      ],
