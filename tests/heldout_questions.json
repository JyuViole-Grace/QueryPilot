      "id": "h01",
      "question": "Which products are currently inactive? Show the ID, name, and price, sorted by product ID in ascending order.",
      "category": "filtering",
      "reference_sql": "SELECT product_id, name, price_cents\n            FROM products\n            WHERE is_active = 0\n            ORDER BY product_id",
      "expected_columns": [
        "product_id",
        "name",
        "price_cents"
