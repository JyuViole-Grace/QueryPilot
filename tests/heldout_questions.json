      "reference_sql": "SELECT c.name, ROUND(AVG(p.price_cents)) AS average_price_cents\n            FROM categories AS c\n            JOIN products AS p ON p.category_id = c.category_id\n            GROUP BY c.category_id, c.name\n            ORDER BY c.name",
