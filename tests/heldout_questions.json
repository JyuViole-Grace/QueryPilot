    {
      "id": "h07",
      "question": "How many product units were sold in delivered orders?",
      "category": "aggregation",
      "reference_sql": "SELECT SUM(oi.quantity) AS units_sold\n            FROM order_items AS oi\n            JOIN orders AS o ON o.order_id = oi.order_id\n            WHERE o.status = 'delivered'",
      "expected_columns": [
        "units_sold"
      ],
      "expected_result": [
        {
          "units_sold": 646
        }
      ],
      "order_sensitive": false
    },
    {
      "id": "h08",
      "question": "What is the average number of product line items per order? Round to two decimal places.",
      "category": "aggregation",
      "reference_sql": "SELECT ROUND(AVG(item_count), 2) AS average_items_per_order\n            FROM (\n                SELECT COUNT(*) AS item_count\n                FROM order_items\n                GROUP BY order_id\n            )",
      "expected_columns": [
        "average_items_per_order"
      ],
      "expected_result": [
        {
          "average_items_per_order": 2.54
        }
      ],
      "order_sensitive": false
    },
    {
      "id": "h09",
      "question": "What are the minimum, maximum, and average prices of active products? Round the average to the nearest integer. Show all three values in kopecks.",
      "category": "aggregation",
      "reference_sql": "SELECT\n                MIN(price_cents) AS min_price_cents,\n                MAX(price_cents) AS max_price_cents,\n                ROUND(AVG(price_cents)) AS average_price_cents\n            FROM products\n            WHERE is_active = 1",
      "expected_columns": [
        "min_price_cents",
        "max_price_cents",
        "average_price_cents"
      ],
      "expected_result": [
        {
          "min_price_cents": 5100,
          "max_price_cents": 247600,
          "average_price_cents": 138758.0
        }
      ],
      "order_sensitive": false
    },
