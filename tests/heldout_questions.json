      "id": "h02",
      "question": "Which customers from the city stored as «Odesa» registered after July 1, 2024? Show their IDs and names.",
      "category": "filtering",
      "reference_sql": "SELECT customer_id, full_name\n            FROM customers\n            WHERE city = 'Odesa' AND registered_at > '2024-07-01'\n            ORDER BY customer_id",
      "expected_columns": [
        "customer_id",
        "full_name"
      ],
      "expected_result": [
        {
          "customer_id": 30,
          "full_name": "Oleksandr Bondarenko"
        }
      ],
      "order_sensitive": false
    },
